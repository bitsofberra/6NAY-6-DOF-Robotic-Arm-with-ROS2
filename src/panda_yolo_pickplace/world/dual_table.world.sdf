<?xml version="1.0"?>
<sdf version="1.8">
  <world name="dual_table">
    <!-- Fizik -->
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
    </scene>

    <!-- Zemin -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Masa 1: blokların olduğu masa (tepe: 0.74m) -->
    <model name="table_1">
      <static>true</static>
      <!-- Kalınlık 0.05m → merkez z = 0.74 - 0.025 = 0.715 -->
      <pose>0.50 0.00 0.715 0 0 0</pose>
      <link name="top">
        <collision name="col">
          <geometry>
            <box><size>1.20 0.80 0.05</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>1.20 0.80 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Masa 2: hedef alanların olduğu masa (tepe: 0.74m) -->
    <model name="table_2">
      <static>true</static>
      <pose>-0.50 0.00 0.715 0 0 0</pose>
      <link name="top">
        <collision name="col">
          <geometry>
            <box><size>1.20 0.80 0.05</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <box><size>1.20 0.80 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Hedef pedler (ince kutular) -->
      <!-- Yükseklik 0.01 → merkez z = 0.74 + 0.005 = 0.745 -->
      <link name="red_pad">
        <pose>-0.50 0.15 0.745 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.10 0.10 0.01</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.10 0.10 0.01</size></box></geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <emissive>0.2 0 0 1</emissive>
          </material>
        </visual>
      </link>

      <link name="green_pad">
        <pose>-0.50 -0.15 0.745 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.10 0.10 0.01</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.10 0.10 0.01</size></box></geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <emissive>0 0.2 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bloklar (0.04m küp → merkez z = 0.74 + 0.02 = 0.76) -->
    <model name="red_block_1">
      <pose>0.50 0.10 0.76 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1e-5</iyy><iyz>0</iyz>
            <izz>1e-5</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_block_1">
      <pose>0.50 -0.10 0.76 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1e-5</iyy><iyz>0</iyz>
            <izz>1e-5</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Üst kamera: renk + derinlik (köprü dosyanla eşleşen topic adları) -->
    <model name="overhead_camera">
      <static>true</static>
      <!-- Masa1 üzerinde, yukarıda; aşağı baksın (pitch ~ -90°) -->
      <pose>0.50 0.00 1.20 0 -1.5708 0</pose>
      <link name="body">
        <sensor name="rgb_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/camera/color/image_raw</topic>
          <camera>
            <horizontal_fov>1.0472</horizontal_fov> <!-- 60 deg -->
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </camera>
        </sensor>

        <sensor name="depth_camera" type="depth_camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/camera/aligned_depth_to_color/image_raw</topic>
          <depth_camera>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </sensor>
      </link>
    </model>

    

  </world>
</sdf>
